{
  "name": "AIXENTRA - AI Music Platform",
  "short_name": "AIXENTRA",
  "description": "Create, stream, remix, and monetize AI music with a premium mobile-first experience.",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090b14",
  "theme_color": "#0b1020",
  "categories": ["music", "entertainment", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ],
  "shortcuts": [
    {
      "name": "Generate Music",
      "short_name": "Generate",
      "description": "Create a new AI-generated track",
      "url": "/generate",
      "icons": [{ "src": "/favicon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Feed",
      "short_name": "Feed",
      "description": "Browse the latest tracks",
      "url": "/feed",
      "icons": [{ "src": "/favicon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Lyrics Studio",
      "short_name": "Lyrics",
      "description": "Write and co-create lyrics with AI",
      "url": "/lyrics-studio",
      "icons": [{ "src": "/favicon.svg", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
